# Copia este archivo como .env (en la raíz del repo) y cambia los valores.
# El .env NO se sube a git: tiene la contraseña del panel.
# Sin ADMIN_PASSWORD el panel web arranca deshabilitado (el juego funciona igual).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Clave para firmar las sesiones del panel. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
