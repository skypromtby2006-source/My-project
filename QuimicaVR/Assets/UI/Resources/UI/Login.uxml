<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Diseño: MDs/diseno_ui/Main.dc.html. Sin contraseña (el login es solo con usuario)
         y con IP + puerto en lugar del selector "Servidor": esta pantalla reemplaza a la
         de Conexión (SPRINT_UI §3). -->
    <Style src="Estilos.uss" />
    <ui:VisualElement name="login" class="pantalla login">
        <ui:VisualElement class="login-izq">
            <ui:Label text="QUÍMICA VR" class="marca" />
            <ui:VisualElement>
                <ui:Label text="Reacciones que&#10;puedes tocar." class="h1-xl" />
                <ui:Label text="Inicia sesión con tu usuario para continuar tu progreso o crea una cuenta para jugar con tus compañeros." class="parrafo-lg" />
            </ui:VisualElement>
            <ui:Label name="estado-servidor" text="Servidor sin conectar" class="chip" />
        </ui:VisualElement>

        <ui:VisualElement class="login-der">
            <ui:VisualElement name="tarjeta" class="card login-card g20">
                <ui:VisualElement class="row g14">
                    <ui:Button name="tab-entrar" text="Entrar" class="btn sm grow" />
                    <ui:Button name="tab-crear" text="Crear cuenta" class="btn sm sec grow" />
                </ui:VisualElement>

                <ui:VisualElement>
                    <ui:VisualElement class="row entre">
                        <ui:Label text="Usuario" class="lbl" />
                        <ui:Label name="ayuda-usuario" text="4 a 16 caracteres: letras, números y _" class="lbl" />
                    </ui:VisualElement>
                    <ui:TextField name="usuario" max-length="16" class="inp" />
                </ui:VisualElement>

                <ui:VisualElement name="solo-crear" class="g14">
                    <ui:VisualElement>
                        <ui:Label text="Nombre visible" class="lbl" />
                        <ui:TextField name="nombre" max-length="20" class="inp" />
                    </ui:VisualElement>
                    <ui:VisualElement>
                        <ui:Label text="Color" class="lbl" />
                        <ui:VisualElement name="colores" class="row g8" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="row g14">
                    <ui:VisualElement class="grow">
                        <ui:Label text="IP del servidor" class="lbl" />
                        <ui:TextField name="ip" max-length="64" class="inp" />
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 130px;">
                        <ui:Label text="Puerto" class="lbl" />
                        <ui:TextField name="puerto" max-length="5" class="inp" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="aviso" class="chip warn" />
                <ui:Button name="accion" text="Entrar" class="btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
